---
import "../styles/global.css";

type Alternate = {
  lang: string;
  href: string;
};

type LayoutProps = {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: string;
  alternates?: Alternate[];
};

const {
  title = "Portfolio",
  description = "Jorge Tabuenca – Economics & Business student focused on markets, macroeconomics and AI in finance.",
  lang = "en",
  canonical,
  alternates = [],
} = Astro.props as LayoutProps;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {canonical && <link rel="canonical" href={canonical} />}

    {alternates.map((alt: Alternate) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
  </head>

  <body>
    <slot />
  </body>
</html>
